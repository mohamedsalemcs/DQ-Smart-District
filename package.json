{
  "name": "dq-smart-district",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"dashboard,ops,portal\" -c \"cyan,magenta,green\" \"npm:dev:admin\" \"npm:dev:security\" \"npm:dev:resident\"",
    "dev:admin": "npm run dev -w @dq/admin",
    "dev:security": "npm run dev -w @dq/security",
    "dev:resident": "npm run dev -w @dq/resident",
    "build": "npm run build -w @dq/admin && npm run build -w @dq/security && npm run build -w @dq/resident && node scripts/assemble.mjs",
    "preview": "npx serve dist -l 4000",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
